{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "kind", "owner", "status", "created_at", "updated_at", "derived_from"],
  "properties": {
    "kind": { "const": "hairness/planning:initiative" },
    "owner": { "type": "string" },
    "status": {
      "enum": ["draft", "ready", "active", "blocked", "complete", "cancelled"]
    },
    "derived_from": { "type": "array", "items": { "type": "string" } }
  }
}
