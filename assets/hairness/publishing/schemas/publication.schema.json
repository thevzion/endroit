{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "kind",
    "owner",
    "status",
    "created_at",
    "updated_at",
    "derived_from",
    "format",
    "title",
    "audience",
    "language",
    "channel"
  ],
  "properties": {
    "kind": { "const": "hairness/publishing:publication" },
    "owner": { "type": "string" },
    "status": {
      "enum": ["outline", "draft", "ready", "published", "superseded"]
    },
    "format": { "type": "string" },
    "title": { "type": "string" },
    "audience": { "type": "string" },
    "language": { "type": "string" },
    "channel": { "type": "string" },
    "derived_from": { "type": "array", "items": { "type": "string" } }
  }
}
