{
  "$schema": "https://hairness.dev/schema/asset.json",
  "name": "hairness/targets",
  "version": "0.5.0-alpha.0",
  "description": "Independent repository declarations, local bindings and bounded Git state.",
  "prefix": "target",
  "capabilities": [
    {
      "id": "manage",
      "source": "capabilities/manage.md",
      "contract": {
        "inputs": ["home", "desk", "target", "binding", "arguments"],
        "requires": ["desk"],
        "produces": ["report"],
        "effects": ["read-home", "read-desk", "read-target", "write-desk", "write-home"]
      }
    },
    {
      "id": "map",
      "source": "capabilities/map.md",
      "contract": {
        "inputs": ["home", "desk", "target", "binding"],
        "requires": ["desk", "target", "binding"],
        "produces": ["artifact", "report"],
        "effects": ["read-home", "read-desk", "read-target", "write-desk"]
      }
    }
  ],
  "skills": [
    {
      "id": "manage",
      "capability": "manage",
      "description": "Use when a repository must be declared, bound or inspected as a Hairness Target."
    },
    {
      "id": "map",
      "capability": "map",
      "description": "Use when a Target needs an inspectable, evidence-backed structural map in the Desk."
    }
  ],
  "commands": [
    {
      "id": "manage",
      "capability": "manage",
      "summary": "Declare, bind or inspect an independent Target."
    },
    {
      "id": "map",
      "capability": "map",
      "summary": "Map a bound Target into a private, publishable Artifact."
    }
  ],
  "cli": [
    {
      "namespace": "target",
      "routes": [
        {
          "name": "list",
          "operation": "kernel:targets.list"
        },
        {
          "name": "discover",
          "operation": "kernel:targets.discover"
        },
        {
          "name": "doctor",
          "operation": "kernel:targets.doctor"
        },
        {
          "name": "add",
          "operation": "kernel:targets.add"
        },
        {
          "name": "bind",
          "operation": "kernel:targets.bind"
        },
        {
          "name": "clone",
          "operation": "kernel:targets.clone"
        },
        {
          "name": "unbind",
          "operation": "kernel:targets.unbind"
        },
        {
          "name": "remove",
          "operation": "kernel:targets.remove"
        },
        {
          "name": "map",
          "operation": "kernel:targets.map"
        }
      ]
    }
  ],
  "artifactKinds": [
    {
      "id": "target-map",
      "template": "templates/target-map.md",
      "requiredFiles": [
        "STACK.md",
        "INTEGRATIONS.md",
        "ARCHITECTURE.md",
        "STRUCTURE.md",
        "CONVENTIONS.md",
        "TESTING.md",
        "CONCERNS.md"
      ],
      "owners": ["desk", "home"],
      "states": ["current", "stale", "archived"]
    }
  ],
  "references": [
    {
      "id": "gsd-attribution",
      "source": "references/gsd-attribution.md",
      "description": "Attribution for the Target Map focus areas."
    }
  ],
  "hud": [
    {
      "id": "targets",
      "probe": "kernel:targets"
    }
  ],
  "settings": {
    "home": "schemas/home-settings.schema.json",
    "desk": "schemas/desk-settings.schema.json"
  }
}
