{
  "$schema": "https://endroit.org/schema/asset.json",
  "name": "endroit/targets",
  "version": "0.7.0-alpha.0",
  "description": "Independent repositories declared by a Home and bound from a collaborator's Desk.",
  "prefix": "endroit",
  "workspaceNamespace": "targeting",
  "files": [
    "capabilities/configure.md",
    "capabilities/manage.md",
    "capabilities/map.md",
    "references/gsd-attribution.md",
    "schemas/home-settings.schema.json",
    "schemas/desk-settings.schema.json",
    "schemas/target-map.schema.json",
    "templates/target-map/artifact.md",
    "templates/target-map/EVIDENCE.json",
    "templates/target-map/STACK.md",
    "templates/target-map/INTEGRATIONS.md",
    "templates/target-map/ARCHITECTURE.md",
    "templates/target-map/STRUCTURE.md",
    "templates/target-map/CONVENTIONS.md",
    "templates/target-map/TESTING.md",
    "templates/target-map/CONCERNS.md",
    "runtime.mjs"
  ],
  "capabilities": [
    {
      "id": "configure",
      "path": "capabilities/configure.md",
      "description": "Discover useful repositories and configure shared Targets plus personal Bindings."
    },
    {
      "id": "manage",
      "path": "capabilities/manage.md",
      "description": "Declare, bind, clone, worktree and inspect independent Target repositories."
    },
    {
      "id": "map",
      "path": "capabilities/map.md",
      "description": "Create an evidence-backed structural map without writing into the Target."
    }
  ],
  "references": [
    {
      "id": "gsd-attribution",
      "path": "references/gsd-attribution.md",
      "description": "Attribution for the Target Map method adapted from GSD Core."
    }
  ],
  "skills": [
    {
      "id": "target-manage",
      "capability": "manage",
      "description": "Use when a repository must be declared, bound, given a managed worktree or inspected as an Endroit Target."
    },
    {
      "id": "target-map",
      "capability": "map",
      "description": "Use when a Target needs an inspectable, evidence-backed structural map in the Desk."
    }
  ],
  "commands": [
    {
      "id": "target-manage",
      "capability": "manage",
      "description": "Manage Endroit Targets and local Bindings."
    },
    {
      "id": "target-map",
      "capability": "map",
      "description": "Map a Target into a Desk Artifact."
    }
  ],
  "artifactKinds": [
    {
      "id": "target-map",
      "schema": "schemas/target-map.schema.json",
      "template": "templates/target-map/artifact.md",
      "owners": ["desk", "home"],
      "states": ["current", "stale"],
      "requiredFiles": [
        "templates/target-map/EVIDENCE.json",
        "templates/target-map/STACK.md",
        "templates/target-map/INTEGRATIONS.md",
        "templates/target-map/ARCHITECTURE.md",
        "templates/target-map/STRUCTURE.md",
        "templates/target-map/CONVENTIONS.md",
        "templates/target-map/TESTING.md",
        "templates/target-map/CONCERNS.md"
      ]
    }
  ],
  "settings": {
    "home": "schemas/home-settings.schema.json",
    "desk": "schemas/desk-settings.schema.json"
  },
  "setup": ["configure"],
  "runtime": {
    "namespace": "target",
    "entry": "runtime.mjs",
    "commands": [
      { "name": "list", "description": "List declared Targets and their Bindings." },
      { "name": "discover", "description": "Discover Git repositories below a directory." },
      { "name": "doctor", "description": "Check Target identities and Bindings." },
      { "name": "add", "description": "Declare a shared Target." },
      { "name": "bind", "description": "Bind an existing checkout." },
      { "name": "clone", "description": "Clone a managed Binding." },
      { "name": "worktree", "description": "Create a managed linked worktree." },
      { "name": "unbind", "description": "Remove a local Binding." },
      { "name": "remove", "description": "Remove a Target declaration." },
      { "name": "inspect", "description": "Collect deterministic read-only evidence from a Target Binding." }
    ]
  }
}
