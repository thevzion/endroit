{
  "name": "@endroit/cli",
  "version": "0.8.0-alpha.0",
  "description": "Create and manage local-first human-agent workplaces with Endroit.",
  "keywords": [
    "ai-agents",
    "agentic",
    "home-first",
    "human-agent-collaboration",
    "local-first",
    "developer-tools",
    "codex",
    "claude-code"
  ],
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevzion/endroit.git"
  },
  "homepage": "https://endroit.org",
  "bugs": {
    "url": "https://github.com/thevzion/endroit/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "bin": {
    "endroit": "bin/endroit.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "docs/reference.md",
    "equipment/endroit/onboarding/",
    "equipment/endroit/planning/",
    "equipment/endroit/publishing/",
    "equipment/endroit/research/",
    "equipment/endroit/hud/",
    "equipment/endroit/artifacts/",
    "equipment/endroit/sites/",
    "equipment/endroit/rooms/",
    "equipment/endroit/scratch/",
    "templates/",
    "schemas/v7/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "conformance": "node scripts/conformance.mjs",
    "test:node22": "npx -y node@22 scripts/run-tests.mjs",
    "test:node24": "npx -y node@24 scripts/run-tests.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:lab": "node scripts/lab-dogfood.mjs",
    "dev:bootstrap": "node scripts/bootstrap-home.mjs",
    "dev:home": "node scripts/development-home.mjs ensure",
    "dev:home:recreate": "node scripts/development-home.mjs recreate",
    "dev:session": "node scripts/development-home.mjs session",
    "dev:verify": "node scripts/development-home.mjs verify",
    "launch:render": "node scripts/render-launch-equipment.mjs",
    "release:pack": "node scripts/release-packages.mjs",
    "release:dry-run": "node scripts/release-publish.mjs --dry-run"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "ajv": "8.20.0"
  }
}
