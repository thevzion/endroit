{
  "name": "@hairness/cli",
  "version": "0.5.0-alpha.2",
  "description": "A Home-first framework for source-owned human-agent work across independent repositories.",
  "keywords": [
    "ai-agents",
    "agentic-assets",
    "ai-harness",
    "provider-agnostic",
    "developer-tools",
    "codex",
    "claude-code"
  ],
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevzion/hairness.git"
  },
  "homepage": "https://hairness.dev",
  "bugs": {
    "url": "https://github.com/thevzion/hairness/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "bin": {
    "hairness": "bin/hairness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "docs/reference.md",
    "assets/hairness/onboarding/",
    "assets/hairness/hud/",
    "assets/hairness/artifacts/",
    "assets/hairness/targets/",
    "assets/hairness/scratch/",
    "templates/",
    "schemas/v5/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "conformance": "node scripts/conformance.mjs",
    "test:node22": "npx -y node@22 scripts/run-tests.mjs",
    "test:node24": "npx -y node@24 scripts/run-tests.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:lab": "node scripts/lab-dogfood.mjs",
    "dev:home": "node scripts/development-home.mjs ensure",
    "dev:home:recreate": "node scripts/development-home.mjs recreate",
    "dev:session": "node scripts/development-home.mjs session",
    "dev:verify": "node scripts/development-home.mjs verify",
    "launch:render": "node scripts/render-launch-assets.mjs",
    "release:pack": "node scripts/release-packages.mjs",
    "release:dry-run": "node scripts/release-publish.mjs --dry-run"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
