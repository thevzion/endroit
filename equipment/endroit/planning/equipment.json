    {
      "id": "to-spec",
      "capability": "to-spec",
      "description": "Use when an Initiative needs a current technical contract."
    },
    {
      "id": "to-tickets",
      "capability": "to-tickets",
      "description": "Use when an Initiative benefits from stable executable tickets."
