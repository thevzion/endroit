    {
      "id": "to-tickets",
      "path": "capabilities/to-tickets.md",
      "description": "Maintain stable executable tickets."
    },
    {
      "id": "handoff",
      "path": "capabilities/handoff.md",
      "description": "Preserve the current resumption state."
