{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "kind",
    "owner",
    "status",
    "created_at",
    "updated_at",
    "derived_from",
    "format",
    "title",
    "audience",
    "language",
    "channel"
  ],
  "properties": {
    "kind": { "const": "endroit/publishing:publication" },
    "owner": { "type": "string" },
    "status": {
      "enum": ["outline", "draft", "ready", "published", "superseded"]
    },
    "format": { "type": "string" },
    "title": { "type": "string" },
    "audience": { "type": "string" },
    "language": { "type": "string" },
    "channel": { "type": "string" },
    "work": { "type": "string" },
    "candidate": { "type": "string" },
    "candidate_revision": { "type": "integer", "minimum": 1 },
    "candidate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "destination": { "type": "string" },
    "handles": { "type": "array", "items": { "type": "string" } },
    "responsibility": { "type": "string" },
    "stability": {
      "enum": ["living", "release-aligned", "dated", "historical"]
    },
    "canonical_dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_publications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "update_triggers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "superseded_by": {
      "type": ["string", "null"]
    },
    "migrated_from": { "type": "string" },
    "migrated_to": { "type": "string" },
    "derived_from": { "type": "array", "items": { "type": "string" } }
  }
}
