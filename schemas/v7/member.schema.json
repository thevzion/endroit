{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schema/v7/member.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "name", "status", "accounts"],
  "properties": {
    "$schema": { "const": "https://endroit.org/schema/v7/member.json" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "status": { "enum": ["active", "inactive"] },
    "accounts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "scope", "identifier"],
        "properties": {
          "service": { "$ref": "#/$defs/id" },
          "scope": { "$ref": "#/$defs/id" },
          "identifier": { "type": "string", "minLength": 1, "maxLength": 500 },
          "handle": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  }
}
