{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schemas/checkpoint/publish-request-v1.schema.json",
  "title": "CheckpointPublishRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "binding", "ownerMember", "line", "parentCheckpoint"],
  "properties": {
    "kind": { "const": "CheckpointPublishRequest" },
    "version": { "const": 1 },
    "binding": { "$ref": "continuity-binding-v1.schema.json" },
    "ownerMember": { "type": "string", "pattern": "^workplace://.+/member/[a-z0-9-]+$" },
    "line": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "parentCheckpoint": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^checkpoint:sha256:[a-f0-9]{64}$" }] }
  }
}
