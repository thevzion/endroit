{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schemas/checkpoint/publish-request-v1.schema.json",
  "title": "CheckpointPublishRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "remote", "recipients", "identities", "baseCheckpoint"],
  "properties": {
    "kind": { "const": "CheckpointPublishRequest" },
    "version": { "const": 1 },
    "remote": { "type": "string", "minLength": 1 },
    "recipients": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["ref", "value"], "properties": { "ref": { "type": "string", "pattern": "^recipient://" }, "value": { "type": "string", "pattern": "^age1[a-z0-9]+$" } } } },
    "identities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "baseCheckpoint": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^checkpoint:sha256:[a-f0-9]{64}$" }] }
  }
}
