{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schemas/checkpoint/fetch-request-v1.schema.json",
  "title": "CheckpointFetchRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "remote", "identities"],
  "properties": {
    "kind": { "const": "CheckpointFetchRequest" },
    "version": { "const": 1 },
    "remote": { "type": "string", "minLength": 1 },
    "identities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
