{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schemas/checkpoint/remote-control-v1.schema.json",
  "title": "Workplace checkpoint remote control v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checkpointId", "algorithm", "recipientRefs", "objects"],
  "properties": {
    "schema": { "const": "workplace-checkpoint-remote-control/1" },
    "checkpointId": { "type": "string", "pattern": "^checkpoint:sha256:[a-f0-9]{64}$" },
    "algorithm": { "const": "age/1" },
    "recipientRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^recipient://" } },
    "objects": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["sha256", "size"], "properties": { "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "size": { "type": "integer", "minimum": 1 } } } }
  }
}
