{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schemas/checkpoint/envelope-record-v1.schema.json",
  "title": "Workplace checkpoint encrypted record header v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "path", "sha256", "size"],
  "properties": {
    "schema": { "const": "workplace-checkpoint-envelope-record/1" },
    "path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "size": { "type": "integer", "minimum": 0 }
  }
}
