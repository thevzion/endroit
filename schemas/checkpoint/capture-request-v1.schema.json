{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schema/workplace-checkpoint-capture-request/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "workplace", "workplaceRevision", "sourceRoot", "output", "roots", "policy"],
  "properties": {
    "kind": { "const": "CheckpointCaptureRequest" },
    "version": { "const": 1 },
    "workplace": { "type": "string", "pattern": "^workplace://" },
    "workplaceRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "worktrees"],
        "properties": {
          "ref": { "type": "string", "pattern": "^workplace://" },
          "worktrees": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path", "logicalPath"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "path": { "type": "string", "minLength": 1 },
                "logicalPath": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includeUntracked", "ignoredPaths"],
      "properties": {
        "includeUntracked": { "type": "boolean" },
        "ignoredPaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["worktree", "path"],
            "properties": {
              "worktree": { "type": "string" },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
