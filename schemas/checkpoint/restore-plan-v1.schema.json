{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endroit.org/schemas/checkpoint/restore-plan-v1.schema.json",
  "title": "Workplace checkpoint restore plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checkpointId", "repositories", "worktrees"],
  "properties": {
    "schema": { "const": "workplace-checkpoint-restore-plan/1" },
    "checkpointId": { "type": "string", "pattern": "^checkpoint:sha256:[a-f0-9]{64}$" },
    "repositories": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["repositoryId", "rootRef", "objectFormat", "bundle", "refs", "worktrees"], "properties": { "repositoryId": { "type": "string" }, "rootRef": { "type": "string" }, "objectFormat": { "enum": ["sha1", "sha256"] }, "bundle": { "type": "string" }, "refs": { "type": "integer", "minimum": 0 }, "worktrees": { "type": "array", "items": { "type": "string" } } } } },
    "worktrees": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["worktreeId", "repositoryId", "logicalPath", "head", "branchRef", "indexEntries", "tracked", "untracked", "ignored", "operation"], "properties": { "worktreeId": { "type": "string" }, "repositoryId": { "type": "string" }, "logicalPath": { "type": "string" }, "head": { "type": "string" }, "branchRef": { "type": ["string", "null"] }, "indexEntries": { "type": "integer", "minimum": 0 }, "tracked": { "type": "integer", "minimum": 0 }, "untracked": { "type": "integer", "minimum": 0 }, "ignored": { "type": "integer", "minimum": 0 }, "operation": { "type": "integer", "minimum": 0 } } } }
  }
}
