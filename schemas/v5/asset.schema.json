{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hairness.dev/schema/asset.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "description"],
  "properties": {
    "$schema": { "const": "https://hairness.dev/schema/asset.json" },
    "name": { "$ref": "#/$defs/assetName" },
    "version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "prefix": { "$ref": "#/$defs/segment" },
    "instructions": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourced" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "capability": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "capability": { "$ref": "#/$defs/id" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/path" },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "$ref": "#/$defs/path" }
        }
      }
    },
    "artifactKinds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owners"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "schema": { "$ref": "#/$defs/path" },
          "template": { "$ref": "#/$defs/path" },
          "targetPath": { "$ref": "#/$defs/path" },
          "requiredFiles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/path" }
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["desk", "home", "target"] }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "cli": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "routes"],
        "properties": {
          "namespace": { "$ref": "#/$defs/id" },
          "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "oneOf": [
                { "required": ["operation"] },
                { "required": ["executable"] }
              ],
              "properties": {
                "name": { "$ref": "#/$defs/id" },
                "operation": { "type": "string", "pattern": "^kernel:[a-z0-9._-]+$" },
                "executable": { "$ref": "#/$defs/id" },
                "defaults": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "hud": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "probe"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "probe": {
            "enum": [
              "kernel:home",
              "kernel:git",
              "kernel:desk",
              "kernel:assets",
              "kernel:artifacts",
              "kernel:targets",
              "kernel:integrations"
            ]
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": { "$ref": "#/$defs/path" },
        "desk": { "$ref": "#/$defs/path" }
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "command"],
        "properties": {
          "scope": { "enum": ["home", "desk"] },
          "command": { "$ref": "#/$defs/id" }
        }
      }
    },
    "executables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entry", "outputs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "entry": { "$ref": "#/$defs/path" },
          "runOn": { "enum": ["build"] },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["child-process"] }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/path" }
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "requestedRef",
        "resolvedCommit",
        "mobile",
        "baseManifestDigest",
        "baseDigests"
      ],
      "properties": {
        "kind": { "enum": ["source", "override"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "requestedRef": { "type": ["string", "null"], "maxLength": 240 },
        "resolvedCommit": { "type": ["string", "null"], "maxLength": 64 },
        "mobile": { "type": "boolean" },
        "baseManifestDigest": { "$ref": "#/$defs/digest" },
        "baseDigests": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/path" },
          "additionalProperties": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "segment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "assetName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/path" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/path" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["arguments", "home", "desk", "target", "binding", "artifact", "settings"]
              }
            },
            "requires": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["desk", "target", "binding", "clean-worktree", "approval"]
              }
            },
            "produces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["artifact", "asset", "projection", "report", "source-change"]
              }
            },
            "effects": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["read-home", "read-desk", "read-target", "write-desk", "write-home", "write-target", "network", "execute"]
              }
            }
          }
        }
      }
    }
  }
}
