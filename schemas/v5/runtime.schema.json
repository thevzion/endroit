{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hairness.dev/schema/runtime.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "argv", "homeRoot", "assetRoot", "resolvedHome", "kernel", "runtimeTrust", "invocation"],
  "properties": {
    "protocol": { "const": "hairness.dev/runtime/v1alpha1" },
    "argv": { "type": "array", "items": { "type": "string" } },
    "homeRoot": { "type": "string", "minLength": 1 },
    "deskRoot": { "type": ["string", "null"] },
    "assetRoot": { "type": "string", "minLength": 1 },
    "resolvedHome": { "type": "object" },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "source", "invoke"],
      "properties": {
        "runtime": { "type": "string" },
        "source": { "enum": ["development", "npm"] },
        "invoke": { "const": "node ./hairness.mjs" }
      }
    },
    "runtimeTrust": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "namespace", "trust"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "namespace": { "type": "string", "minLength": 1 },
          "trust": { "enum": ["bundled", "approved", "pending"] },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "error": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["command", "wake-up"] },
        "provider": { "enum": ["codex", "claude"] }
      }
    }
  }
}
