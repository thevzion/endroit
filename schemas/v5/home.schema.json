{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hairness.dev/schema/home.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "runtime", "mode", "providers"],
  "properties": {
    "$schema": { "const": "https://hairness.dev/schema/home.json" },
    "name": { "$ref": "#/$defs/id" },
    "runtime": {
      "type": "string",
      "pattern": "^@hairness/cli@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "mode": { "enum": ["solo", "team"] },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claude"] }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": { "$ref": "#/$defs/segment" },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instructionsBytes": { "type": "integer", "minimum": 0 },
            "skillDescriptionsBytes": { "type": "integer", "minimum": 0 },
            "hudPromptBytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/assetName" },
      "additionalProperties": { "type": "object" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "segment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "assetName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
    }
  }
}
